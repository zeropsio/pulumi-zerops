{
    "compilerOptions": {
        // Output
        "outDir": "bin",
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "stripInternal": true,
        // Environment
        "target": "ES2022",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "moduleDetection": "force",
        "types": ["node"],
        // Type Checking
        "strict": true,
        "noFallthroughCasesInSwitch": true,
        "noImplicitReturns": true,
        "skipLibCheck": true
    },
    "files": [
        "config/index.ts",
        "config/vars.ts",
        "getLocations.ts",
        "getOrganization.ts",
        "getProject.ts",
        "getProjectExport.ts",
        "getProjects.ts",
        "getRegions.ts",
        "getService.ts",
        "getServiceEnvVars.ts",
        "getServiceTypes.ts",
        "index.ts",
        "integrationToken.ts",
        "objectStorage.ts",
        "project.ts",
        "projectDedicatedIpv4.ts",
        "projectEnv.ts",
        "projectImport.ts",
        "projectL7BalancerConfig.ts",
        "projectPrometheusConfig.ts",
        "projectRemoteLogging.ts",
        "projectVpnPeer.ts",
        "provider.ts",
        "publicHttpRouting.ts",
        "publicPortRouting.ts",
        "service.ts",
        "serviceBackupConfig.ts",
        "serviceDeploy.ts",
        "serviceEnv.ts",
        "serviceGitIntegration.ts",
        "serviceRestart.ts",
        "serviceSubdomainAccess.ts",
        "types/index.ts",
        "types/input.ts",
        "types/output.ts",
        "utilities.ts"
    ]
}
